{
  "expo": {
    "name": "fitness-app",
    "slug": "fitness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitnessapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Allow KineticLab to read steps and active calories for health goal tracking.",
        "NSHealthUpdateUsageDescription": "Allow KineticLab to sync your workout and activity data."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.fitnessapp"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitness App to access your camera to scan food labels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload PT plans.",
          "cameraPermission": "The app accesses your camera to let you photograph PT plans."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "react-native-health",
        {
          "NSHealthShareUsageDescription": "Allow KineticLab to read steps and active calories for health goal tracking.",
          "NSHealthUpdateUsageDescription": "Allow KineticLab to sync your workout and activity data."
        }
      ],
      [
        "react-native-health-connect",
        {
          "permissions": ["READ_STEPS", "READ_ACTIVE_CALORIES_BURNED", "READ_TOTAL_CALORIES_BURNED"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "666fd616-a95c-421b-92bb-f203002f9d71"
      }
    }
  }
}
